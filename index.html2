<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap');

  * { box-sizing: border-box; }

  #eki-journal-root {
    --paper: #EAE4D3;
    --paper-2: #E1D9C3;
    --ink: #2A2823;
    --ink-soft: #6B6455;
    --indigo: #2C4A63;
    --indigo-deep: #1D3346;
    --seal: #A13D2D;
    --gold: #A8823F;
    --line: #C7BCA0;
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--ink);
    background: var(--paper);
    max-width: 680px;
    margin: 0 auto;
    padding: 28px 20px 60px;
    line-height: 1.7;
  }

  #eki-journal-root .header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
  }

  #eki-journal-root .seal {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background: var(--seal);
    color: #EFE6D3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Noto Serif JP', serif;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -2px;
    box-shadow: inset 0 0 0 1px rgba(239,230,211,0.35);
  }

  #eki-journal-root h1 {
    font-family: 'Noto Serif JP', serif;
    font-weight: 700;
    font-size: 24px;
    margin: 0 0 2px;
    color: var(--indigo-deep);
    letter-spacing: 0.02em;
  }

  #eki-journal-root .subtitle {
    font-size: 13px;
    color: var(--ink-soft);
    margin: 0;
  }

  #eki-journal-root .card {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 20px;
    margin-bottom: 22px;
  }

  #eki-journal-root .card h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 16px;
    color: var(--indigo-deep);
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }

  #eki-journal-root .pillar-block {
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 12px 14px;
    background: var(--paper);
    margin-bottom: 14px;
  }

  #eki-journal-root .pillar-label {
    font-family: 'Noto Serif JP', serif;
    font-size: 13px;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: 0.04em;
  }

  #eki-journal-root label.field-label {
    display: block;
    font-size: 12px;
    color: var(--ink-soft);
    margin-bottom: 4px;
    margin-top: 8px;
  }

  #eki-journal-root .pillar-block > label.field-label:first-of-type { margin-top: 0; }

  #eki-journal-root select,
  #eki-journal-root input[type="date"],
  #eki-journal-root input[type="text"],
  #eki-journal-root textarea {
    width: 100%;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 14px;
    color: var(--ink);
    background: #F4EFE1;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 7px 8px;
  }

  #eki-journal-root select { font-family: 'Noto Serif JP', serif; font-weight: 500; }

  #eki-journal-root textarea {
    resize: vertical;
    min-height: 80px;
    line-height: 1.7;
    margin-top: 8px;
  }

  #eki-journal-root .hidden-stems {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }

  #eki-journal-root .hidden-stems-title {
    font-size: 11px;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }

  #eki-journal-root .hidden-row {
    display: grid;
    grid-template-columns: 84px 1fr;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  #eki-journal-root .hidden-row:last-child { margin-bottom: 0; }

  #eki-journal-root .hidden-stem-name {
    font-family: 'Noto Serif JP', serif;
    font-size: 13px;
    color: var(--indigo-deep);
  }

  #eki-journal-root .hidden-stem-name .type {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 10px;
    color: var(--ink-soft);
    display: block;
  }

  #eki-journal-root .row { margin-bottom: 4px; }

  #eki-journal-root .save-btn {
    margin-top: 16px;
    background: var(--indigo);
    color: #EFE6D3;
    border: none;
    border-radius: 3px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    letter-spacing: 0.02em;
  }
  #eki-journal-root .save-btn:hover { background: var(--indigo-deep); }
  #eki-journal-root .save-btn:disabled { opacity: 0.5; cursor: default; }

  #eki-journal-root .search-wrap { margin-bottom: 18px; }
  #eki-journal-root .search-wrap input { background: var(--paper-2); }

  #eki-journal-root .list-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
  }

  #eki-journal-root .list-header h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 15px;
    color: var(--indigo-deep);
    margin: 0;
  }

  #eki-journal-root .count { font-size: 12px; color: var(--ink-soft); }

  #eki-journal-root .entry {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  #eki-journal-root .entry-date { font-size: 12px; color: var(--ink-soft); padding-top: 2px; }

  #eki-journal-root .pillar-summary { margin-bottom: 8px; }

  #eki-journal-root .badge {
    font-family: 'Noto Serif JP', serif;
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 3px 8px;
    background: var(--paper-2);
    display: inline-block;
    margin: 0 6px 4px 0;
  }

  #eki-journal-root .badge b { color: var(--indigo-deep); font-size: 13px; }

  #eki-journal-root .hidden-summary {
    font-size: 11px;
    color: var(--ink-soft);
    margin: 0 0 6px 2px;
  }

  #eki-journal-root .entry-theme { font-weight: 700; font-size: 14px; margin-bottom: 4px; color: var(--ink); }
  #eki-journal-root .entry-text { font-size: 14px; color: var(--ink); white-space: pre-wrap; }
  #eki-journal-root .entry-actions { margin-top: 8px; }

  #eki-journal-root .delete-link {
    font-size: 11px;
    color: var(--seal);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: 'Noto Sans JP', sans-serif;
  }
  #eki-journal-root .delete-link:hover { text-decoration: underline; }

  #eki-journal-root .empty-state { text-align: center; padding: 40px 16px; color: var(--ink-soft); font-size: 13px; }
  #eki-journal-root .footer-links { text-align: center; margin-top: 30px; }

  #eki-journal-root .reset-link {
    font-size: 11px;
    color: var(--ink-soft);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    font-family: 'Noto Sans JP', sans-serif;
  }

  #eki-journal-root .loading { text-align: center; padding: 40px; color: var(--ink-soft); font-size: 13px; }
  #eki-journal-root .note {
    font-size: 11px;
    color: var(--ink-soft);
    margin: -8px 0 18px;
  }
</style>

<div id="eki-journal-root">
  <div class="header">
    <div class="seal">易</div>
    <div>
      <h1>易学ジャーナル</h1>
      <p class="subtitle">年柱・月柱・日柱と蔵干の通変星を記す研鑽ノート</p>
    </div>
  </div>

  <div class="card" id="ej-account-card">
    <h2>クラウド同期</h2>
    <div id="ej-auth-status" style="font-size:13px;color:var(--ink-soft);margin-bottom:10px;">
      メールアドレスとパスワードでログインすると、iPhone・Android・Macで記録を同期できます。
    </div>
    <div id="ej-auth-form">
      <label class="field-label">メールアドレス</label>
      <input type="email" id="ej-email" autocomplete="email" placeholder="あなたのメールアドレス">
      <label class="field-label">パスワード</label>
      <input type="password" id="ej-password" autocomplete="current-password" placeholder="6文字以上">
      <div class="row" style="margin-top:10px;">
        <button class="save-btn" id="ej-signup" type="button">新規登録</button>
        <button class="save-btn" id="ej-login" type="button">ログイン</button>
      </div>
      <p class="note" style="margin-top:10px;">初回だけ「新規登録」。以後は「ログイン」で使えます。</p>
    </div>
    <button class="reset-link" id="ej-logout" type="button" style="display:none;">ログアウト</button>
  </div>

  <div class="card">
    <h2>新しい記録</h2>
    <div class="row">
      <label class="field-label">日付</label>
      <input type="date" id="ej-date">
    </div>

    <div id="ej-pillars"></div>

    <label class="field-label">見出し（任意）</label>
    <input type="text" id="ej-theme" placeholder="例：面談での気づき">

    <label class="field-label">振り返り</label>
    <textarea id="ej-text" placeholder="気づいたこと、鑑定の内容などを記す"></textarea>

    <button class="save-btn" id="ej-save">記録を保存</button>
  </div>

  <div class="search-wrap">
    <label class="field-label">干支・通変星で検索</label>
    <input type="text" id="ej-search" placeholder="例：甲子　／　通変星や本文の語句も可">
  </div>

  <div class="list-header">
    <h2>これまでの記録</h2>
    <span class="count" id="ej-count"></span>
  </div>

  <div id="ej-list">
    <div class="loading">読み込み中…</div>
  </div>

  <div class="footer-links">
    <button class="reset-link" id="ej-reset">すべての記録を削除する</button>
  </div>
</div>

<script>
(function () {
  const STEMS = ['甲','乙','丙','丁','戊','己','庚','辛','壬','癸'];
  const BRANCHES = ['子','丑','寅','卯','辰','巳','午','未','申','酉','戌','亥'];
  const GANZHI60 = Array.from({length: 60}, (_, i) => STEMS[i % 10] + BRANCHES[i % 12]);
  const TSUHENSEI = ['比肩','劫財','食神','傷官','偏財','正財','偏官（七殺）','正官','偏印','印綬'];
  const STORAGE_KEY = 'eki-journal-entries-v2';

  // 十二支蔵干表（余気・中気・本気）
  const HIDDEN_STEMS = {
    '子': [{stem:'壬', type:'余気'}, {stem:'癸', type:'本気'}],
    '丑': [{stem:'癸', type:'余気'}, {stem:'辛', type:'中気'}, {stem:'己', type:'本気'}],
    '寅': [{stem:'戊', type:'余気'}, {stem:'丙', type:'中気'}, {stem:'甲', type:'本気'}],
    '卯': [{stem:'甲', type:'余気'}, {stem:'乙', type:'本気'}],
    '辰': [{stem:'乙', type:'余気'}, {stem:'癸', type:'中気'}, {stem:'戊', type:'本気'}],
    '巳': [{stem:'戊', type:'余気'}, {stem:'庚', type:'中気'}, {stem:'丙', type:'本気'}],
    '午': [{stem:'丙', type:'余気'}, {stem:'己', type:'中気'}, {stem:'丁', type:'本気'}],
    '未': [{stem:'丁', type:'余気'}, {stem:'乙', type:'中気'}, {stem:'己', type:'本気'}],
    '申': [{stem:'戊', type:'余気'}, {stem:'壬', type:'中気'}, {stem:'庚', type:'本気'}],
    '酉': [{stem:'庚', type:'余気'}, {stem:'辛', type:'本気'}],
    '戌': [{stem:'辛', type:'余気'}, {stem:'丁', type:'中気'}, {stem:'戊', type:'本気'}],
    '亥': [{stem:'戊', type:'余気'}, {stem:'甲', type:'中気'}, {stem:'壬', type:'本気'}]
  };

  const PILLARS = [
    { key: 'year', label: '年柱' },
    { key: 'month', label: '月柱' },
    { key: 'day', label: '日柱' }
  ];

  const root = document.getElementById('eki-journal-root');
  const $ = (id) => root.querySelector('#' + id);

  function optionsHtml(list) {
    return list.map(o => `<option value="${o}">${o}</option>`).join('');
  }

  // フォームの年柱・月柱・日柱ブロックを構築
  const pillarsContainer = $('ej-pillars');
  pillarsContainer.innerHTML = PILLARS.map(p => `
    <div class="pillar-block" data-pillar="${p.key}">
      <div class="pillar-label">${p.label}</div>
      <label class="field-label">干支</label>
      <select id="ej-${p.key}-ganzhi">${optionsHtml(GANZHI60)}</select>
      <label class="field-label">天干の通変星</label>
      <select id="ej-${p.key}-stem-tg">${optionsHtml(TSUHENSEI)}</select>
      <div class="hidden-stems">
        <div class="hidden-stems-title">蔵干の通変星</div>
        <div id="ej-${p.key}-hidden"></div>
      </div>
    </div>
  `).join('');

  function branchOf(ganzhi) { return ganzhi.slice(-1); }

  function renderHiddenRows(pillarKey, presetHidden) {
    const ganzhi = $('ej-' + pillarKey + '-ganzhi').value;
    const branch = branchOf(ganzhi);
    const stems = HIDDEN_STEMS[branch] || [];
    const container = $('ej-' + pillarKey + '-hidden');
    container.innerHTML = stems.map((s, i) => `
      <div class="hidden-row">
        <span class="hidden-stem-name">${s.stem}<span class="type">${s.type}</span></span>
        <select id="ej-${pillarKey}-hidden-${i}" data-stem="${s.stem}" data-type="${s.type}">${optionsHtml(TSUHENSEI)}</select>
      </div>
    `).join('');
    if (presetHidden) {
      stems.forEach((s, i) => {
        const match = presetHidden.find(h => h.stem === s.stem && h.type === s.type);
        if (match) {
          const sel = $('ej-' + pillarKey + '-hidden-' + i);
          if (sel) sel.value = match.tenGod;
        }
      });
    }
  }

  PILLARS.forEach(p => {
    $('ej-' + p.key + '-ganzhi').addEventListener('change', () => renderHiddenRows(p.key));
    renderHiddenRows(p.key);
  });

  const todayStr = new Date().toISOString().slice(0, 10);
  $('ej-date').value = todayStr;

  let entries = [];

  // ====== 易学ジャーナル：クラウド同期設定 ======
  const SUPABASE_URL = 'YOUR_SUPABASE_URL';
  const SUPABASE_PUBLISHABLE_KEY = 'YOUR_SUPABASE_PUBLISHABLE_KEY';

  const cloudEnabled =
    window.supabase &&
    SUPABASE_URL.startsWith('https://') &&
    !SUPABASE_URL.includes('YOUR_') &&
    SUPABASE_PUBLISHABLE_KEY.startsWith('sb_') &&
    !SUPABASE_PUBLISHABLE_KEY.includes('YOUR_');

  const supabase = cloudEnabled
    ? window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY)
    : null;

  const LOCAL_KEY = 'eki-journal-local-v3';
  let currentSession = null;

  function normalizeCloudRow(row) {
    return {
      id: row.id,
      date: row.date,
      year: row.year,
      month: row.month,
      day: row.day,
      theme: row.theme || '',
      text: row.text || '',
      createdAt: row.created_at || ''
    };
  }

  function localLoad() {
    try {
      const raw = localStorage.getItem(LOCAL_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function localSave() {
    localStorage.setItem(LOCAL_KEY, JSON.stringify(entries));
    return true;
  }

  async function loadEntries() {
    if (!cloudEnabled || !supabase) {
      entries = localLoad();
      renderList();
      return;
    }
    if (!currentSession) {
      entries = [];
      renderList();
      return;
    }

    const { data, error } = await supabase
      .from('entries')
      .select('*')
      .eq('user_id', currentSession.user.id)
      .order('date', { ascending: false })
      .order('created_at', { ascending: false });

    if (error) {
      console.error(error);
      alert('クラウドから記録を読み込めませんでした。');
      entries = [];
    } else {
      entries = (data || []).map(normalizeCloudRow);
    }
    renderList();
  }

  async function saveEntryToCloud(entry) {
    if (!currentSession) {
      alert('記録を保存するにはログインしてください。');
      return false;
    }
    const payload = {
      id: entry.id,
      user_id: currentSession.user.id,
      date: entry.date,
      year: entry.year,
      month: entry.month,
      day: entry.day,
      theme: entry.theme,
      text: entry.text,
      created_at: entry.createdAt
    };
    const { error } = await supabase.from('entries').upsert(payload);
    if (error) {
      console.error(error);
      alert('クラウド保存に失敗しました。');
      return false;
    }
    return true;
  }

  async function deleteEntryFromCloud(id) {
    if (!currentSession) {
      alert('削除するにはログインしてください。');
      return false;
    }
    const { error } = await supabase
      .from('entries')
      .delete()
      .eq('id', id)
      .eq('user_id', currentSession.user.id);
    if (error) {
      console.error(error);
      alert('クラウドから削除できませんでした。');
      return false;
    }
    return true;
  }

  async function deleteAllCloud() {
    if (!currentSession) {
      alert('削除するにはログインしてください。');
      return false;
    }
    const { error } = await supabase
      .from('entries')
      .delete()
      .eq('user_id', currentSession.user.id);
    if (error) {
      console.error(error);
      alert('クラウドの記録を削除できませんでした。');
      return false;
    }
    return true;
  }

  function updateAuthUI(session) {
    const status = $('ej-auth-status');
    const form = $('ej-auth-form');
    const logout = $('ej-logout');

    if (!cloudEnabled) {
      status.textContent = 'Supabaseの接続設定がまだ完了していません。';
      form.style.display = 'block';
      logout.style.display = 'none';
      return;
    }

    if (session && session.user) {
      status.textContent = 'ログイン中：' + session.user.email + '（クラウド同期ON）';
      form.style.display = 'none';
      logout.style.display = 'inline-block';
    } else {
      status.textContent = 'メールアドレスとパスワードでログインしてください。';
      form.style.display = 'block';
      logout.style.display = 'none';
    }
  }

  async function initAuth() {
    if (!cloudEnabled || !supabase) {
      updateAuthUI(null);
      await loadEntries();
      return;
    }

    const { data } = await supabase.auth.getSession();
    currentSession = data.session;
    updateAuthUI(currentSession);
    await loadEntries();

    supabase.auth.onAuthStateChange(async (_event, session) => {
      currentSession = session;
      updateAuthUI(session);
      await loadEntries();
    });
  }

  $('ej-signup').addEventListener('click', async () => {
    if (!cloudEnabled || !supabase) {
      alert('まずSupabaseの接続設定を完了してください。');
      return;
    }

    const email = $('ej-email').value.trim();
    const password = $('ej-password').value;

    if (!email) {
      alert('メールアドレスを入力してください。');
      return;
    }
    if (password.length < 6) {
      alert('パスワードは6文字以上にしてください。');
      return;
    }

    const { data, error } = await supabase.auth.signUp({ email, password });

    if (error) {
      console.error(error);
      alert('新規登録に失敗しました：' + error.message);
      return;
    }

    if (data.session) {
      alert('アカウントを作成しました。ログイン済みです。');
    } else {
      alert('登録は完了しました。Supabaseの「Confirm email」がONの場合は、確認メールが必要です。');
    }
  });

  $('ej-login').addEventListener('click', async () => {
    if (!cloudEnabled || !supabase) {
      alert('まずSupabaseの接続設定を完了してください。');
      return;
    }

    const email = $('ej-email').value.trim();
    const password = $('ej-password').value;

    if (!email || !password) {
      alert('メールアドレスとパスワードを入力してください。');
      return;
    }

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      console.error(error);
      alert('ログインに失敗しました：' + error.message);
    }
  });

  $('ej-logout').addEventListener('click', async () => {
    if (supabase) await supabase.auth.signOut();
  });

  function collectPillarData(pillarKey) {
    const ganzhi = $('ej-' + pillarKey + '-ganzhi').value;
    const branch = branchOf(ganzhi);
    const stems = HIDDEN_STEMS[branch] || [];
    const hidden = stems.map((s, i) => {
      const sel = $('ej-' + pillarKey + '-hidden-' + i);
      return { stem: s.stem, type: s.type, tenGod: sel ? sel.value : '' };
    });
    return {
      ganzhi,
      stemTenGod: $('ej-' + pillarKey + '-stem-tg').value,
      hidden
    };
  }

  function escapeHtml(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function pillarMatches(pillarData, q) {
    if (!pillarData) return false;
    if (pillarData.ganzhi.includes(q)) return true;
    if (pillarData.stemTenGod.includes(q)) return true;
    return (pillarData.hidden || []).some(h => h.stem.includes(q) || h.tenGod.includes(q));
  }

  function pillarBadgeHtml(label, pillarData) {
    if (!pillarData) return '';
    const hiddenText = (pillarData.hidden || [])
      .map(h => `${h.stem}(${h.type})${h.tenGod}`)
      .join('・');
    return `
      <div>
        <span class="badge">${label}　<b>${pillarData.ganzhi}</b>　${pillarData.stemTenGod}</span>
        ${hiddenText ? `<div class="hidden-summary">蔵干：${hiddenText}</div>` : ''}
      </div>
    `;
  }

  function renderList(filterText) {
    const listEl = $('ej-list');
    const countEl = $('ej-count');
    let shown = entries.slice().sort((a, b) => (b.date + b.createdAt).localeCompare(a.date + a.createdAt));

    if (filterText && filterText.trim()) {
      const q = filterText.trim();
      shown = shown.filter(en =>
        pillarMatches(en.year, q) ||
        pillarMatches(en.month, q) ||
        pillarMatches(en.day, q) ||
        (en.theme && en.theme.includes(q)) ||
        (en.text && en.text.includes(q))
      );
    }

    countEl.textContent = entries.length ? `${shown.length} / ${entries.length} 件` : '';

    if (!entries.length) {
      listEl.innerHTML = '<div class="empty-state">まだ記録がありません。上のフォームから最初の一件を記してみましょう。</div>';
      return;
    }
    if (!shown.length) {
      listEl.innerHTML = '<div class="empty-state">該当する記録が見つかりませんでした。</div>';
      return;
    }

    listEl.innerHTML = shown.map(en => `
      <div class="entry" data-id="${en.id}">
        <div class="entry-date">${en.date}</div>
        <div>
          <div class="pillar-summary">
            ${pillarBadgeHtml('年柱', en.year)}
            ${pillarBadgeHtml('月柱', en.month)}
            ${pillarBadgeHtml('日柱', en.day)}
          </div>
          ${en.theme ? `<div class="entry-theme">${escapeHtml(en.theme)}</div>` : ''}
          ${en.text ? `<div class="entry-text">${escapeHtml(en.text)}</div>` : ''}
          <div class="entry-actions">
            <button class="delete-link" data-id="${en.id}">この記録を削除</button>
          </div>
        </div>
      </div>
    `).join('');

    listEl.querySelectorAll('.delete-link').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('この記録を削除しますか？')) return;
        const id = btn.dataset.id;
        if (cloudEnabled && supabase) {
          const ok = await deleteEntryFromCloud(id);
          if (!ok) return;
        }
        entries = entries.filter(e => e.id !== id);
        if (!cloudEnabled) localSave();
        renderList($('ej-search').value);
      });
    });
  }

  $('ej-save').addEventListener('click', async () => {
    const date = $('ej-date').value || todayStr;
    const entry = {
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
      date,
      year: collectPillarData('year'),
      month: collectPillarData('month'),
      day: collectPillarData('day'),
      theme: $('ej-theme').value,
      text: $('ej-text').value,
      createdAt: new Date().toISOString()
    };
    const saveBtn = $('ej-save');
    saveBtn.disabled = true;
    saveBtn.textContent = '保存中…';
    let ok = true;
    if (cloudEnabled && supabase) {
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) {
        alert('記録を保存するには先にログインしてください。');
        ok = false;
      } else {
        entries.push(entry);
        ok = await saveEntryToCloud(entry);
        if (!ok) entries.pop();
      }
    } else {
      entries.push(entry);
      ok = localSave();
      if (!ok) entries.pop();
    }
    saveBtn.disabled = false;
    saveBtn.textContent = '記録を保存';
    if (ok) {
      $('ej-theme').value = '';
      $('ej-text').value = '';
      renderList($('ej-search').value);
    }
  });

  $('ej-search').addEventListener('input', (e) => renderList(e.target.value));

  $('ej-reset').addEventListener('click', async () => {
    if (!confirm('すべての記録を削除します。この操作は取り消せません。よろしいですか？')) return;
    if (cloudEnabled && supabase) {
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) {
        alert('削除するには先にログインしてください。');
        return;
      }
      const ok = await deleteAllCloud();
      if (!ok) return;
    }
    entries = [];
    if (!cloudEnabled) localSave();
    renderList();
  });

  initAuth();
})();
</script>
